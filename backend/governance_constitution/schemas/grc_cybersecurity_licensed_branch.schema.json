{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanadcom.local/schemas/grc-cybersecurity-licensed-branch.schema.json",
  "title": "GRC Cybersecurity Licensed Branch Constitutional Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "document_id",
    "version",
    "branch_license",
    "decision_object"
  ],
  "properties": {
    "document_type": {
      "const": "LicensedBranchConstitution"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "branch_license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_id",
        "origin",
        "branch",
        "effective_attribute",
        "sabab",
        "conditions",
        "blockers_mani",
        "qadih_differences",
        "evidence_requirements",
        "rank_policy",
        "residual_policy"
      ],
      "properties": {
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "effective_attribute": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sabab": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers_mani": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qadih_differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trace_fields",
            "minimum_set"
          ],
          "properties": {
            "trace_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minimum_set": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rank_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_threshold_rank"
          ],
          "properties": {
            "action_threshold_rank": {
              "type": "string",
              "enum": [
                "ZERO",
                "CANDIDATE",
                "HYPOTHESIS",
                "SUPPORTED",
                "VERIFIED"
              ]
            }
          }
        },
        "residual_policy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "origin",
        "branch",
        "branch_license_ref",
        "effective_attribute",
        "sabab",
        "evaluated_conditions",
        "mani_blockers",
        "qadih_differences",
        "evidence_trace_evaluation",
        "rank",
        "failed_stage",
        "residuals",
        "handoff_delivery_decision"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "branch_license_ref": {
          "type": "string",
          "minLength": 1
        },
        "effective_attribute": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sabab": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_conditions": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "minProperties": 1
        },
        "mani_blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qadih_differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_trace_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim",
            "relation_tested",
            "result",
            "weakest_binding_rank"
          ],
          "properties": {
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "relation_tested": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "PROVEN",
                "PARTIAL",
                "UNPROVEN"
              ]
            },
            "weakest_binding_rank": {
              "type": "string",
              "enum": [
                "ZERO",
                "CANDIDATE",
                "HYPOTHESIS",
                "SUPPORTED",
                "VERIFIED"
              ]
            }
          }
        },
        "rank": {
          "type": "string",
          "enum": [
            "ZERO",
            "CANDIDATE",
            "HYPOTHESIS",
            "SUPPORTED",
            "VERIFIED"
          ]
        },
        "failed_stage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "ORIGIN",
            "BRANCH_LICENSE",
            "EFFECTIVE_ATTRIBUTE",
            "SABAB",
            "CONDITIONS",
            "MANI",
            "QADIH_DIFFERENCE",
            "EVIDENCE_TRACE",
            "RANK",
            "RESIDUALS",
            "HANDOFF"
          ]
        },
        "residuals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff_delivery_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handoff_to",
            "delivery_decision",
            "action_allowed",
            "licensed_action",
            "blocked_action"
          ],
          "properties": {
            "handoff_to": {
              "type": "string",
              "minLength": 1
            },
            "delivery_decision": {
              "type": "string",
              "enum": [
                "DEFERRED_ACTION",
                "ALLOWED_ACTION",
                "BLOCKED_ACTION",
                "HUMAN_REVIEW_REQUIRED"
              ]
            },
            "action_allowed": {
              "type": "boolean"
            },
            "licensed_action": {
              "type": "string",
              "minLength": 1
            },
            "blocked_action": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "handoff_delivery_decision": {
                "properties": {
                  "delivery_decision": {
                    "const": "ALLOWED_ACTION"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failed_stage": {
                "const": null
              },
              "handoff_delivery_decision": {
                "properties": {
                  "action_allowed": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "failed_stage": {
                "type": "string"
              },
              "residuals": {
                "minItems": 1
              },
              "handoff_delivery_decision": {
                "properties": {
                  "action_allowed": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
