# ─────────────────────────────────────────────────────────────
# Sanadcom GRC Platform — Environment Variables Template
#
# Copy this file to .env and fill in every value marked REQUIRED.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Django / Backend ────────────────────────────────────────
# REQUIRED: generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production
DJANGO_DEBUG=False

# Public URL of the application (used for CSRF and CORS)
CISO_ASSISTANT_URL=https://your-domain.example.com

# Session token TTL in seconds (2 hours)
AUTH_TOKEN_TTL=7200

# ── Database ────────────────────────────────────────────────
# REQUIRED
POSTGRES_NAME=ciso-assistant
POSTGRES_USER=ciso-assistantuser
# REQUIRED: use a strong random password, minimum 32 characters
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# ── Timezone ────────────────────────────────────────────────
# Saudi Arabia Standard Time (UTC+3)
TIME_ZONE=Asia/Riyadh

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_HOST=smtp.your-domain.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@your-domain.example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True

# ── Qeyas KPI Integration ────────────────────────────────────
# Base URL of the Qeyas API (leave blank to disable the integration)
QEYAS_API_URL=https://qeyas.your-domain.example.com/api/v1

# API key for M2M authentication with Qeyas
# REQUIRED when QEYAS_API_URL is set
QEYAS_API_KEY=change-me

# Verify TLS certificate when calling Qeyas (set to False only in dev/test)
QEYAS_VERIFY_SSL=True

# Timeout in seconds for Qeyas API calls
QEYAS_TIMEOUT=30

# Kafka bootstrap servers for event publishing (leave blank to disable)
# Example: kafka1:9092,kafka2:9092
KAFKA_BOOTSTRAP_SERVERS=

# Kafka topic for Sanadcom compliance events
KAFKA_COMPLIANCE_EVENTS_TOPIC=sanadcom.compliance.events

# Kafka topic for Sanadcom risk events
KAFKA_RISK_EVENTS_TOPIC=sanadcom.risk.events

# ── Storage ──────────────────────────────────────────────────
# Set to True and configure the AWS_* variables below to use S3-compatible storage
USE_S3=False
# AWS_STORAGE_BUCKET_NAME=sanadcom-evidence
# AWS_S3_ENDPOINT_URL=https://s3.your-domain.example.com
# AWS_S3_REGION_NAME=me-south-1
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me

# ── Audit log ────────────────────────────────────────────────
AUDITLOG_RETENTION_DAYS=365

# ── Sentry Error Monitoring ──────────────────────────────────
# Set to your Sentry project DSN to enable error tracking in production.
# Leave blank to disable Sentry.
SENTRY_DSN=
# Environment label sent with every Sentry event (production, staging, dev)
SENTRY_ENVIRONMENT=production
# Fraction of transactions to send to Sentry for performance monitoring (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
