# Copy to .env (git-ignored) before `docker compose up`. Compose refuses to start without these.
# Never commit .env; rotate both values if they were ever exposed.

# Database password shared by the postgres, backend and huey services.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Django secret key, shared by backend and huey (sessions and tokens are signed with it;
# an unset key is regenerated on every restart and differs between the two services).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
